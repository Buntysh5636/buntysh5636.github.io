
<style>
.pixel-search {
  max-width: 850px;
  margin: 25px auto;
  padding: 12px;
  background: #141e2e;
  border: 1px solid #33445d;
  border-radius: 16px;
  box-sizing: border-box;
}
.pixel-search form {
  display: flex;
  gap: 10px;
}
.pixel-search input {
  flex: 1;
  min-width: 0;
  padding: 15px;
  border: 1px solid #394a63;
  border-radius: 10px;
  background: #090e18;
  color: #fff;
  font-size: 16px;
  outline: none;
}
.pixel-search input:focus {
  border-color: #a5ff5c;
}
.pixel-search button {
  padding: 13px 20px;
  border: 0;
  border-radius: 10px;
  background: #a5ff5c;
  color: #10170b;
  font-weight: bold;
  cursor: pointer;
}
.pixel-search button:hover {
  background: #c0ff8c;
}
#pixelSearchStatus {
  color: #aab6c8;
  margin: 10px 3px 0;
  font-size: 13px;
}
@media(max-width:480px) {
  .pixel-search form {
    flex-direction: column;
  }
  .pixel-search button {
    width: 100%;
  }
}
</style>

<div class="pixel-search">
  <form id="pixelSearchForm" role="search">
    <input
      id="pixelSearchInput"
      type="search"
      placeholder="🔎 Pesquisar jogos, GTA V, Minecraft..."
      aria-label="Pesquisar jogos"
    >
    <button type="submit">Pesquisar</button>
  </form>
  <p id="pixelSearchStatus" aria-live="polite">
    Pesquisa jogos pelo nome ou categoria.
  </p>
</div>

<script>
(function () {
  const form = document.getElementById("pixelSearchForm");
  const input = document.getElementById("pixelSearchInput");
  const status = document.getElementById("pixelSearchStatus");

  function searchGames() {
    const query = input.value.trim().toLocaleLowerCase();
    const cards = document.querySelectorAll(
      ".game-card, .card, [data-game]"
    );

    let visible = 0;

    cards.forEach(function (card) {
      if (card.closest(".pixel-search")) return;

      const text = card.textContent.toLocaleLowerCase();
      const matches = !query || text.includes(query);

      card.hidden = !matches;
      if (matches) visible++;
    });

    status.textContent = query
      ? visible + (visible === 1
          ? " resultado encontrado."
          : " resultados encontrados.")
      : "Pesquisa jogos pelo nome ou categoria.";
  }

  input.addEventListener("input", searchGames);

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    searchGames();
    document.getElementById("catalogo")?.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  });
})();
</script>
